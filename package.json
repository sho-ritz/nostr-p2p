{
  "name": "nostr-p2p",
  "version": "0.0.0",
  "description": "Serverless P2P over nostr relays: WebRTC with automatic encrypted relay fallback.",
  "type": "module",
  "license": "MIT",
  "author": "show-ritz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sho-ritz/nostr-p2p.git"
  },
  "keywords": ["nostr", "p2p", "webrtc", "serverless", "relay"],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "PROTOCOL.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "nostr-tools": "^2.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
